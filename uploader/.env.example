# Copy to .env.local for local dev; set the same names in Vercel > Settings > Environment Variables.

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Fine-grained token for the images repo only:
#   Contents: Read and write, Metadata: Read-only
GITHUB_TOKEN=

# Target repo (defaults shown)
GITHUB_OWNER=wrteam-vimal
GITHUB_REPO=WRTeam-Presentation-Images
GITHUB_BRANCH=main
